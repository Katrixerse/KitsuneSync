# For `npm run dev` against the Postgres from `docker compose up -d db`.
# Copy to .env.local and adjust if you changed POSTGRES_PASSWORD or POSTGRES_PORT.
DATABASE_URL=postgres://kitsune:kitsune@localhost:5432/kitsunesync

# Read by compose.yaml (put them in .env next to it).
# POSTGRES_PASSWORD=kitsune
# POSTGRES_PORT=5432
# APP_PORT=3000
